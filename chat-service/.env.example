APP_NAME=chat-service
ENV=dev
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://mock:mock@localhost:5432/mockstack
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (use strong secrets in production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=72

# gRPC
AI_GRPC_TARGET=ai-service:50051
AI_GRPC_TIMEOUT_SECONDS=10.0

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
